# Copy to `.env` and fill in. Vite only exposes variables prefixed with VITE_.
# These are Firebase *web* config values: they identify the project and are
# designed to be public. Access control is enforced by firestore.rules and
# storage.rules, not by keeping these secret. Never put service-account keys
# or other server secrets in a VITE_ variable — they would ship to every browser.

# Firebase web app config (console.firebase.google.com -> Project settings -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Optional: only needed for "keep a copy of my original file" on upload.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Shown on the /contact page. Leave blank to show "not configured".
VITE_CONTACT_EMAIL=

# Optional: self-host the OCR engine (see README, "OCR assets"). When unset,
# tesseract.js downloads its worker, WASM core and English data from a CDN
# the first time a scanned PDF is uploaded.
VITE_OCR_ASSET_PATH=

# Local development against the Firebase Emulator Suite (`npm run emulators`).
# VITE_USE_FIREBASE_EMULATORS=true
