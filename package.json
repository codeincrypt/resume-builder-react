{
  "name": "capitalcv",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "CapitalCV \u2014 upload or build a resume, pick from 25 capital-city templates, download a PDF.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/parsing/__tests__/parse.test.ts",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-capitalcv",
    "ocr:assets": "node scripts/copy-ocr-assets.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@fontsource-variable/crimson-pro": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/libre-baskerville": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@reduxjs/toolkit": "^2.12.0",
    "antd": "^6.6.1",
    "dayjs": "^1.11.13",
    "firebase": "^12.17.1",
    "html2canvas-pro": "^2.3.8",
    "jspdf": "^4.2.1",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "redux-persist": "^6.0.0",
    "tesseract.js": "^7.0.0"
