rules_version = '2';

// CapitalCV Firestore rules.
//
// Everything a user owns lives under /users/{uid}; the only person who can
// touch it is that uid, and only with a verified email. There is no query that
// crosses users, so there is no rule that needs to allow one.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Google accounts arrive verified; password accounts must click the link.
    function verified() {
      return request.auth.token.email_verified == true;
    }

    function validResume(data) {
      return data.keys().hasOnly([
          'title', 'templateId', 'content', 'design', 'sections',
          'source', 'originalFile', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.templateId is string && data.templateId.size() <= 40
        && data.content is map
        && data.design is map
        && data.sections is list && data.sections.size() <= 60
        && (data.source == 'scratch' || data.source == 'upload');
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid) && verified();

      match /resumes/{resumeId} {
        allow read, delete: if isOwner(uid) && verified();

        allow create: if isOwner(uid) && verified() && validResume(request.resource.data);

        allow update: if isOwner(uid) && verified()
          && validResume(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
